{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix ../backend run dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "test": "node --test src/imageUrl.test.js src/shopApi.test.js src/architecture.test.js src/storeCore.test.js",
    "lint": "oxlint src vite.config.js --deny-warnings",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
