DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=
DB_NAME=tienda
JWT_SECRET=
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Solo detrás del nginx de confianza:
TRUST_PROXY=0
# Importes en centavos de MXN; configuración del servidor, no del frontend:
SHIPPING_FEE_CENTS=9900
FREE_SHIPPING_CENTS=150000
# Sin instrucciones, transferencia no aparece como forma de pago.
TRANSFER_INSTRUCTIONS=
# Opcionales, necesarios para correo y recuperación de contraseña:
RESEND_API_KEY=
MAIL_FROM=
